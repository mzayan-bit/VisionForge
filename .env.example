# ==============================================================================
# VisionForge Environment Configuration Reference (.env.example)
# Copy this file to `.env` and configure variables according to your environment.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE APPLICATION SETTINGS (REQUIRED)
# ------------------------------------------------------------------------------
# Execution environment mode: 'development', 'staging', 'production', 'testing'
ENVIRONMENT=development

# Enable or disable detailed error tracing and interactive docs in production
DEBUG=false

# Global logging severity: 'DEBUG', 'INFO', 'WARNING', 'ERROR', 'CRITICAL'
LOG_LEVEL=INFO

# ------------------------------------------------------------------------------
# 2. NETWORKING & PORT MAPPINGS (REQUIRED)
# ------------------------------------------------------------------------------
# Backend host binding and port
HOST=0.0.0.0
BACKEND_PORT=8000
PORT=8000

# Frontend Web UI port
FRONTEND_PORT=3000

# Internal backend URL used by frontend Next.js reverse proxy rewrite
BACKEND_INTERNAL_URL=http://backend:8000

# Allowed CORS origins for cross-origin browser requests
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# ------------------------------------------------------------------------------
# 3. STORAGE & AI INFRASTRUCTURE (REQUIRED / DEFAULTS PROVIDED)
# ------------------------------------------------------------------------------
# Root storage path for persistent datasets, checkpoints, and visual memory
DATA_DIR=~/.cache/visionforge

# Directory for installed and cached model weights
MODEL_CACHE_DIR=~/.cache/visionforge/models

# Target compute device: 'auto' (detects MPS/CUDA/CPU), 'cpu', 'cuda', 'mps'
DEFAULT_DEVICE=auto

# Maximum concurrent deep learning models loaded in memory/RAM cache
MAX_CACHED_MODELS=3

# ------------------------------------------------------------------------------
# 4. OPTIONAL EXTERNAL INTEGRATIONS (OPTIONAL - BUILT-IN DEFAULTS ACTIVE)
# ------------------------------------------------------------------------------
# Optional SQL Database URL (VisionForge includes built-in file transaction engine)
# DATABASE_URL=postgresql://visionforge:visionforge@postgres:5432/visionforge_db

# Optional Redis Cache & Message Queue URL (VisionForge includes in-memory queue)
# REDIS_URL=redis://redis:6379/0

# Optional Qdrant Vector Search URL (VisionForge includes built-in VisualMemoryIndex)
# QDRANT_URL=http://qdrant:6333

# Optional Neo4j Graph Database URL (VisionForge includes native lineage graph)
# NEO4J_URL=bolt://neo4j:password@neo4j:7687

# Optional MLflow Tracking Server URI (VisionForge includes built-in Experiment Tracking)
# MLFLOW_TRACKING_URI=http://mlflow:5000

# ------------------------------------------------------------------------------
# 5. MULTIMODAL VISION-LANGUAGE PROVIDERS (OPTIONAL)
# ------------------------------------------------------------------------------
# Optional API keys for cloud vision-language models (VisionForge operates without them)
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
